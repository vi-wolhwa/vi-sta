{
  "name": "@vi-sta/renderer",
  "version": "0.0.0",
  "description": "Pure, DOM-free renderer that turns vi-sta keyword source into HTML. Designed for SSR/SSG/RSC; does not depend on the editor engine.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  }
}
