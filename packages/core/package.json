{
  "name": "@vi-sta/core",
  "version": "0.0.0",
  "description": "Framework-agnostic engine for the vi-sta editor: schema, keyword engine, serializer, and view controllers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/extension-document": "catalog:",
    "@tiptap/extension-paragraph": "catalog:",
    "@tiptap/extension-text": "catalog:",
    "@tiptap/extension-heading": "catalog:",
    "@tiptap/extension-bold": "catalog:",
    "@tiptap/extension-italic": "catalog:",
    "@tiptap/extension-hard-break": "catalog:"
  }
}
